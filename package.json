{
  "name": "foreman",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "version": "0.1.0",
  "license": "MIT",
  "bin": {
    "foreman": "src/cli/main.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/ui",
    "build": "bun run build:plugin && bun run build:ui",
    "build:plugin": "bun build src/hooks/main.ts --target bun --outfile plugin/dist/hook.js && bun build src/mcp/main.ts --target bun --outfile plugin/dist/mcp.js",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "foreman": "bun src/cli/main.ts"
  },
  "engines": {
    "bun": ">=1.3.5"
  }
}
